<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="relatorio_com_grupos" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
  <parameter name="PK_NUNOTA" class="java.math.BigDecimal"/>
  <queryString><![CDATA[SELECT NUNOTA, NUMNOTA, CODPARC, NOMEPARC, VLRNOTA FROM TGFCAB]]></queryString>
  <field name="NUNOTA" class="java.math.BigDecimal"/>
