  <variable name="SUBTOTAL_CLIENTE" class="java.math.BigDecimal" resetType="Group" resetGroup="GrupoCliente" calculation="Sum">
    <variableExpression><![CDATA[$F{VLRNOTA}]]></variableExpression>
  </variable>
  <group name="GrupoCliente">
    <groupExpression><![CDATA[$F{CODPARC}]]></groupExpression>
    <groupHeader>
      <band height="24" splitType="Stretch">
