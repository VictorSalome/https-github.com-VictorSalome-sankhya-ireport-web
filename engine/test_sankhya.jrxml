        <textElement verticalAlignment="Middle">
          <font size="9" isBold="true"/>
        </textElement>
        <text><![CDATA[Cliente:]]></text>
      </staticText>
    </band>
  </pageHeader>
  <columnHeader>
    <band height="26" splitType="Stretch">
      <staticText>
        <reportElement x="8" y="4" width="70" height="18" forecolor="#475569"/>
        <textElement verticalAlignment="Middle">
          <font size="8" isBold="true"/>
        </textElement>
        <text><![CDATA[NRO ÚNICO]]></text>
      </staticText>
    </band>
  </columnHeader>
  <detail>
    <band height="24" splitType="Stretch">
      <textField>
        <reportElement x="8" y="2" width="70" height="18" forecolor="#1E293B"/>
        <textElement verticalAlignment="Middle">
          <font size="9"/>
        </textElement>
        <textFieldExpression><![CDATA[$F{NUNOTA}]]></textFieldExpression>
      </textField>
    </band>
